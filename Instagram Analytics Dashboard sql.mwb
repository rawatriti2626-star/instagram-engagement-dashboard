SELECT*FROM superstore_orders;

SELECT
    category,
    ROUND(SUM(sales), 2)                         AS total_sales,
    ROUND(SUM(profit), 2)                        AS total_profit,
    ROUND(SUM(profit) / SUM(sales) * 100, 2)    AS profit_margin_pct
FROM superstore_orders
GROUP BY category
ORDER BY total_sales DESC;

SELECT
    DATE_FORMAT(order_date, '%Y-%m')  AS month,
    ROUND(SUM(sales), 2)              AS monthly_sales,
    COUNT(DISTINCT order_id)          AS num_orders
FROM superstore_orders
GROUP BY month
ORDER BY month;

SELECT
    customer_id,
    customer_name,
    ROUND(SUM(sales), 2)          AS total_spent,
    COUNT(DISTINCT order_id)      AS orders_placed
FROM superstore_orders
GROUP BY customer_id, customer_name
ORDER BY total_spent DESC
LIMIT 10;

SELECT
    order_id,
    product_name,
    discount,
    ROUND(sales, 2)   AS sales,
    ROUND(profit, 2)  AS profit
FROM superstore_orders
WHERE profit < 0
ORDER BY profit ASC
LIMIT 20;

SELECT
    ship_mode,
    ROUND(AVG(DATEDIFF(ship_date, order_date)), 1)  AS avg_days_to_ship,
    COUNT(*)                                         AS total_orders
FROM superstore_orders
GROUP BY ship_mode
ORDER BY avg_days_to_ship;

SELECT
    region,
    COUNT(DISTINCT customer_id)   AS unique_customers,
    ROUND(SUM(sales), 2)          AS total_sales,
    ROUND(SUM(profit), 2)         AS total_profit,
    ROUND(AVG(discount) * 100, 1) AS avg_discount_pct
FROM superstore_orders
GROUP BY region
ORDER BY total_profit DESC;

SELECT
    category,
    sub_category,
    ROUND(SUM(profit), 2)  AS total_profit,
    RANK() OVER (
        PARTITION BY category
        ORDER BY SUM(profit) DESC
    )                       AS profit_rank
FROM superstore_orders
GROUP BY category, sub_category
ORDER BY category, profit_rank;

SELECT
    DATE_FORMAT(order_date, '%Y-%m')           AS month,
    ROUND(SUM(sales), 2)                       AS monthly_sales,
    ROUND(SUM(SUM(sales)) OVER (
        ORDER BY DATE_FORMAT(order_date, '%Y-%m')
    ), 2)                                      AS running_total
FROM superstore_orders
GROUP BY month
ORDER BY month;

SELECT
    segment,
    sub_category,
    ROUND(SUM(profit) / SUM(sales) * 100, 1)  AS margin_pct,
    CASE
        WHEN SUM(profit) / SUM(sales) >= 0.20  THEN 'High margin'
        WHEN SUM(profit) / SUM(sales) >= 0.05  THEN 'Medium margin'
        WHEN SUM(profit) / SUM(sales) >= 0      THEN 'Low margin'
        ELSE                                         'Loss-making'
    END                                        AS margin_band
FROM superstore_orders
GROUP BY segment, sub_category
ORDER BY margin_pct DESC;

SELECT
    customer_name,
    customer_id,
    COUNT(DISTINCT order_id)   AS total_orders,
    ROUND(SUM(sales), 2)       AS lifetime_value,
    MIN(order_date)            AS first_order_date
FROM superstore_orders
GROUP BY customer_id, customer_name
HAVING COUNT(DISTINCT order_id) = 1
ORDER BY lifetime_value DESC;


SELECT COUNT(*) AS total_rows
FROM superstore_orders;

SELECT
  COUNT(*) AS total_rows,
  SUM(CASE WHEN order_id      IS NULL THEN 1 ELSE 0 END) AS null_order_id,
  SUM(CASE WHEN customer_name IS NULL THEN 1 ELSE 0 END) AS null_customer,
  SUM(CASE WHEN sales         IS NULL THEN 1 ELSE 0 END) AS null_sales,
  SUM(CASE WHEN profit        IS NULL THEN 1 ELSE 0 END) AS null_profit,
  SUM(CASE WHEN quantity      IS NULL THEN 1 ELSE 0 END) AS null_quantity,
  SUM(CASE WHEN order_date    IS NULL THEN 1 ELSE 0 END) AS null_order_date
FROM superstore_orders;

-- Check for duplicate row_ids
SELECT row_id, COUNT(*) AS occurrences
FROM superstore_orders
GROUP BY row_id
HAVING COUNT(*) > 1;

-- Also check for fully duplicate rows
SELECT order_id, product_id, COUNT(*) AS dupes
FROM superstore_orders
GROUP BY order_id, product_id
HAVING COUNT(*) > 1;

SELECT
  MIN(order_date) AS earliest_order,
  MAX(order_date) AS latest_order,
  COUNT(DISTINCT YEAR(order_date)) AS years_covered
FROM superstore_orders;

SELECT COUNT(*) AS bad_dates
FROM superstore_orders
WHERE ship_date < order_date;

SELECT DISTINCT category FROM superstore_orders ORDER BY category;
SELECT DISTINCT region FROM superstore_orders ORDER BY region;
SELECT DISTINCT ship_mode FROM superstore_orders ORDER BY ship_mode;

SELECT
  MIN(sales)    AS min_sales,
  MAX(sales)    AS max_sales,
  MIN(quantity) AS min_qty,
  MAX(quantity) AS max_qty,
  MIN(discount) AS min_disc,
  MAX(discount) AS max_disc,
  MIN(profit)   AS min_profit,
  MAX(profit)   AS max_profit
FROM superstore_orders;

SELECT
    category,
    ROUND(SUM(sales), 2)                        AS total_sales,
    ROUND(SUM(profit), 2)                       AS total_profit,
    ROUND(SUM(profit) / SUM(sales) * 100, 2)   AS profit_margin_pct
FROM superstore_orders
GROUP BY category
ORDER BY total_sales DESC;

SELECT
    region,
    ROUND(SUM(sales), 2)                        AS total_sales,
    ROUND(SUM(profit), 2)                       AS total_profit,
    COUNT(DISTINCT order_id)                    AS total_orders,
    ROUND(AVG(discount) * 100, 1)               AS avg_discount_pct
FROM superstore_orders
GROUP BY region
ORDER BY total_profit DESC;

SELECT
    customer_name,
    customer_id,
    ROUND(SUM(sales), 2)         AS total_revenue,
    ROUND(SUM(profit), 2)        AS total_profit,
    COUNT(DISTINCT order_id)     AS total_orders
FROM superstore_orders
GROUP BY customer_name, customer_id
ORDER BY total_revenue DESC
LIMIT 10;


SELECT
    YEAR(order_date)                             AS year,
    MONTH(order_date)                            AS month,
    DATE_FORMAT(order_date, '%Y-%m')            AS month_label,
    ROUND(SUM(sales), 2)                        AS monthly_sales,
    COUNT(DISTINCT order_id)                    AS num_orders
FROM superstore_orders
GROUP BY year, month, month_label
ORDER BY year, month;

SELECT
    CASE
        WHEN discount = 0              THEN 'No discount'
        WHEN discount <= 0.2           THEN '1–20% discount'
        WHEN discount <= 0.4           THEN '21–40% discount'
        ELSE                                '41%+ discount'
    END                                  AS discount_band,
    COUNT(*)                             AS num_orders,
    ROUND(SUM(sales), 2)               AS total_sales,
    ROUND(SUM(profit), 2)              AS total_profit,
    ROUND(AVG(profit), 2)              AS avg_profit_per_order
FROM superstore_orders
GROUP BY discount_band
ORDER BY discount_band;

SELECT
    ship_mode,
    COUNT(*)                                              AS total_orders,
    ROUND(AVG(DATEDIFF(ship_date, order_date)), 1)      AS avg_days_to_ship,
    MIN(DATEDIFF(ship_date, order_date))                 AS fastest_days,
    MAX(DATEDIFF(ship_date, order_date))                 AS slowest_days
FROM superstore_orders
GROUP BY ship_mode
ORDER BY avg_days_to_ship
